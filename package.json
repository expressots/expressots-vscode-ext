{
  "name": "expressots",
  "displayName": "ExpressoTS",
  "description": "VS Code extension for ExpressoTS — CLI wrapper and TypeScript snippets for 4.x.",
  "version": "1.0.0",
  "publisher": "expressots",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/expressots/expressots-vscode-ext"
  },
  "bugs": {
    "url": "https://github.com/expressots/expressots-vscode-ext/issues"
  },
  "homepage": "https://expresso-ts.com",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "expressots",
    "express",
    "typescript",
    "nodejs",
    "scaffolding"
  ],
  "activationEvents": [
    "workspaceContains:expressots.config.ts"
  ],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "test": "npm run compile && node ./out/test/cli.test.js",
    "lint": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.3.3"
  }
}
